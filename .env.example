# ==============================================================================
# AGENTDESK PRODUCTION ENVIRONMENT CONFIGURATION (ZERO-COST MVP)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Exposed to browser via Vite - Non-Sensitive)
# ------------------------------------------------------------------------------
# Optional custom public app title or public assets base URL
VITE_APP_TITLE="AgentDesk - AI Revenue & Operations Platform"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (STRICTLY SERVER-ONLY - NEVER EXPOSED TO BROWSER)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for grounded AI completions and embeddings.
# Automatically injected at runtime in Google AI Studio / Cloud Run via Secrets panel.
GEMINI_API_KEY=""

# APP_URL: The public production URL where this application is hosted.
# Automatically injected at runtime by Google AI Studio Cloud Run container.
APP_URL=""

# ------------------------------------------------------------------------------
# 3. OPTIONAL PAYMENT GATEWAYS (Zero-Cost Free Mode by default)
# Only configure if real paid payment processing is enabled for live transactions.
# ------------------------------------------------------------------------------
# Razorpay Credentials (Supports INR, USD, GBP)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# PayPal Credentials (Supports USD, GBP)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_WEBHOOK_ID=""

