# ==============================================================================
# AGENTDESK PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME (Required for Application Startup)
# ------------------------------------------------------------------------------
DATABASE_URL=
SESSION_SECRET=
APP_URL=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_INITIAL_PASSWORD=

# ------------------------------------------------------------------------------
# 2. TRANSACTIONAL EMAIL (Brevo - Primary)
# API key must be stored only in the deployment secret store (for example Render).
# Do NOT put BREVO_API_KEY in source control or Vite/client-side variables.
# ------------------------------------------------------------------------------
BREVO_API_KEY=
EMAIL_FROM=hello.agentdesktech@gmail.com
EMAIL_FROM_NAME=AgentDesk
EMAIL_REPLY_TO=hello.agentdesktech@gmail.com

# ------------------------------------------------------------------------------
# 3. GMAIL API (OAuth 2.0 - Legacy / Optional)
# Refresh token is acquired via Connect Gmail OAuth flow in Platform Admin.
# Do NOT supply GOOGLE_REFRESH_TOKEN manually.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. RAZORPAY (Subscriptions & Billing Engine)
# Optional in dev; required when enabling live subscription checkout.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME & GEMINI AI ENGINE
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 6. SESSION PERSISTENCE & DATABASE
# Production always requires PostgreSQL-backed sessions with external DATABASE_URL.
# Set ENABLE_EMBEDDED_DB=true in development to enable embedded PGlite when an external DATABASE_URL is not provided.
# ------------------------------------------------------------------------------
ENABLE_EMBEDDED_DB=false
REQUIRE_PERSISTENT_SESSIONS=false

# ------------------------------------------------------------------------------
# 7. OPTIONAL DEMO USERS (Development/demo environments only)
# Keep disabled in production. When enabled, supply passwords through the
# environment; never commit demo passwords to source control.
# ------------------------------------------------------------------------------
ENABLE_DEMO_USERS=false
DEMO_SUMMIT_PASSWORD=
DEMO_SHARMA_PASSWORD=
DEMO_LONDON_PASSWORD=
